# Basic whitespace rules for editors; `make format` applies the full style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 2

[*.{js,mjs,css,html}]
indent_style = space
indent_size = 4

[*.{py,lua}]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Upstream code keeps its own style.
[{third_party,sw}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
