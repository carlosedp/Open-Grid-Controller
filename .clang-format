# Style of our own C code (iii-open-grid/). Without this file, editors fall
# back to their own defaults and reformat whole files on save.
BasedOnStyle: Google
IndentWidth: 2
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
IncludeBlocks: Preserve
SortIncludes: false
# pointer style of the existing code, iii and the Pico SDK: `char *p`
DerivePointerAlignment: false
PointerAlignment: Right
